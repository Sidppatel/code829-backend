DATABASE_URL=postgresql://ep_dev:ep_dev_password@localhost:5432/event_platform
REDIS_URL=redis://localhost:6379
ASPNETCORE_ENVIRONMENT=Development
PORT=8000

# Secrets — all sensitive keys are environment variables (never stored in DB)
JWT_SECRET=<generate: openssl rand -hex 32>
STRIPE_SECRET_KEY=<sk_test_... or sk_live_...>
STRIPE_PUBLISHABLE_KEY=<pk_test_... or pk_live_...>
STRIPE_WEBHOOK_SECRET=<whsec_...>
RESEND_API_KEY=<re_...>
S3_ACCESS_KEY=<Cloudflare R2 access key ID>
S3_SECRET_KEY=<Cloudflare R2 secret access key>
S3_BUCKET=<R2 bucket name>
S3_ENDPOINT_URL=<https://ACCOUNT_ID.r2.cloudflarestorage.com>
CDN_BASE_URL=<https://cdn.example.com>
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
