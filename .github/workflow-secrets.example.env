# GitHub Actions secrets + variables for code829-backend
# ─────────────────────────────────────────────────────────────────────────────
# Set these in: github.com/Sidppatel/code829-backend → Settings → Secrets and
# variables → Actions. Values shown as "<…>" must be filled per-environment.
#
# This is a template. Do NOT commit a real version of this file with values —
# the .env.example pattern keeps it lint-safe + gitleaks-safe.
#
# Currently consumed by:
#   .github/workflows/ci.yml                       (build + tests + Testcontainers)
#   .github/workflows/security.yml                 (gitleaks + NuGet audit)
#   .github/workflows/cloudflare-cidr-refresh.yml  (auto-PR for CF CIDR drift)


# ─── Repo-level secrets ──────────────────────────────────────────────────────

# Cross-repo PAT (fine-grained, repo: Sidppatel/code829-db, perms: contents:read).
# Used by ci.yml integration-tests to clone code829-db so MigrationRunner can
# bootstrap the Testcontainers Postgres schema. Required — integration-tests
# job fails at the checkout step without it.
DB_REPO_TOKEN=<fine-grained-PAT-with-code829-db-contents-read>

# Optional. Gitleaks paid-tier license key. Without it, security.yml + the
# inline gitleaks step in ci.yml run in free mode (limited rule set).
GITLEAKS_LICENSE=<gitleaks-paid-license-or-leave-unset>


# ─── Repo-level variables ────────────────────────────────────────────────────
# (none currently consumed by backend workflows)


# ─── Auto-provided by Actions runtime (do NOT set manually) ──────────────────
# GITHUB_TOKEN — auto-issued per workflow run, repo-scoped.
