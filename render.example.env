# Render dashboard environment for code829-backend
# ─────────────────────────────────────────────────────────────────────────────
# Set these in: dashboard.render.com → code829-backend service → Environment.
# Values shown as "<…>" must be filled per-deployment.
#
# Source of truth for the keys with pinned values is render.yaml (Blueprint).
# This file mirrors what the running service expects and serves as a
# pre-deploy checklist — fill, paste into the dashboard, redeploy.
#
# Backend reads each key directly via Environment.GetEnvironmentVariable or
# IConfiguration. No URL form is ever read; DB + Redis connections are
# composed at boot from the components below.


# ─── Runtime (pinned in render.yaml — do NOT override unless intentional) ────
ASPNETCORE_ENVIRONMENT=Production
PORT=10000
FRONTEND_URL=https://code829.com
CORS_ORIGINS=https://code829.com,https://admin.code829.com,https://developer.code829.com,https://staff.code829.com
TRUSTED_PROXIES=173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22
CLOUDFLARE_IPV6_CIDRS=2400:cb00::/32,2606:4700::/32,2803:f800::/32,2405:b500::/32,2405:8100::/32,2a06:98c0::/29,2c0f:f248::/32
CF_IP_ALLOWLIST_ENFORCE=false
REDIS_TLS=true


# ─── Schema pin (bumped per migration via auto-PR from code829-db) ───────────
# Backend boot fails fast if the latest row in __EFMigrationsHistory does not
# match this exact MigrationId. Updated automatically by the bump-pin job in
# code829-db/.github/workflows/migrate.yml.
EXPECTED_MIGRATION_ID=<latest-MigrationId-after-each-prod-migration>


# ─── Postgres (Supabase transaction pooler) ──────────────────────────────────
DB_HOST=<host>.pooler.supabase.com
DB_PORT=6543
DB_USER=postgres.<project-ref>
DB_NAME=postgres
DB_PASSWORD=<supabase-password>
# Supabase pooler — use Require. VerifyFull requires the pooler cert's CN
# to match the connection host exactly, which it does not for transaction-mode
# PgBouncer endpoints. Require keeps TLS encryption without strict chain
# validation. Code default for non-Development is VerifyFull, so this MUST
# be set explicitly on Render or boot fails with "remote certificate was
# rejected".
DATABASE_SSL_MODE=Require
# Optional pool tuning. Defaults: 1 / 20 / 60s / 30s / 15s.
# DB_MIN_POOL=
# DB_MAX_POOL=
# DB_IDLE_LIFETIME=
# DB_CMD_TIMEOUT=
# DB_CONN_TIMEOUT=


# ─── Redis (Upstash TLS) ─────────────────────────────────────────────────────
REDIS_HOST=<host>.upstash.io
REDIS_PORT=6380
REDIS_USER=default
REDIS_PASSWORD=<upstash-token>


# ─── Auth + signing ──────────────────────────────────────────────────────────
# 32+ bytes. Generate: openssl rand -hex 32
JWT_SECRET=<64-char-hex>
# Optional. Set during rotation grace window — old tokens still validate.
# JWT_SECRET_PREVIOUS=


# ─── Stripe ──────────────────────────────────────────────────────────────────
# Live keys required in Production (sk_live_*). Test keys blocked outside Dev.
STRIPE_SECRET_KEY=sk_live_<…>
STRIPE_PUBLISHABLE_KEY=pk_live_<…>
STRIPE_WEBHOOK_SECRET=whsec_<…>


# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_<…>
EMAIL_FROM_ADDRESS=noreply@code829.com


# ─── Storage (Cloudflare R2 via S3 API) ──────────────────────────────────────
S3_ACCESS_KEY=<r2-access-key-id>
S3_SECRET_KEY=<r2-secret-access-key>
S3_BUCKET=<bucket-name>
S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# Optional. Defaults to us-east-1 (R2 ignores region but SDK requires one).
# S3_REGION=
CDN_BASE_URL=https://cdn.code829.com


# ─── Frontend admin (Stripe Connect return URLs) ─────────────────────────────
FRONTEND_URL_ADMIN=https://admin.code829.com


# ─── Developer API ───────────────────────────────────────────────────────────
# Bearer token gating a small set of public-facing OpenAPI export endpoints.
OPENAPI_PUBLIC_TOKEN=<long-random-token>


# ─── Observability (optional — service runs without these) ───────────────────
# Sentry — absent disables transport.
SENTRY_DSN=
# If unset, Program.cs falls back to RENDER_GIT_COMMIT (auto-set by Render),
# then to the assembly version.
SENTRY_RELEASE=
# Grafana Cloud OTLP gateway. Endpoint form:
#   https://otlp-gateway-prod-<region>.grafana.net/otlp
OTEL_EXPORTER_OTLP_ENDPOINT=
# Authorization=Basic <base64(instance_id:api_token)>
OTEL_EXPORTER_OTLP_HEADERS=


# ─── Optional: ClamAV malware scan on uploads ────────────────────────────────
# CLAMAV_HOST=
# CLAMAV_PORT=


# ─── Auto-provided by Render (do NOT set) ────────────────────────────────────
# RENDER_GIT_COMMIT — populated by Render at deploy time; consumed as a
# Sentry release / OTEL service version fallback.
